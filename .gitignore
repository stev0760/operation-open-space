# Original game files: local only, never committed (see original.sha256)
/original/*
!/original/.gitkeep

# Regenerated outputs
/work/
/build*/
/re/.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# Ghidra project files
*.gpr
*.rep/
*.lock
*.lock~

# Oracle bulk output (digests under oracle/digests/ are committed)
/oracle/runs/
*.log
